# Speakly Backend Environment Configuration
# Copy this file to .env and fill in your values

# Application
SPEAKLY_ENVIRONMENT=prod
SPEAKLY_LOG_LEVEL=INFO

# Database (Railway will auto-provide DATABASE_URL)
DATABASE_URL=postgresql://user:password@host:port/database
# For local development:
# DATABASE_URL=sqlite:///./data/app.db

# Audio Storage
SPEAKLY_AUDIO_DIR=storage/audio

# ElevenLabs STT Integration
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_WEBHOOK_SECRET=your_webhook_secret_here
ELEVENLABS_WEBHOOK_ID=your_webhook_id_here
ELEVENLABS_DIARIZATION_ENABLED=true
ELEVENLABS_DIARIZATION_THRESHOLD=0.5

# Ollama LLM (for local development or separate GPU server)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# TickTick Integration (Optional)
TICKTICK_CLIENT_ID=your_ticktick_client_id
TICKTICK_CLIENT_SECRET=your_ticktick_client_secret
TICKTICK_REDIRECT_URI=https://your-domain.com/api/ticktick/callback

# Developer Mode (set to false for production)
SPEAKLY_DEVELOPER_MODE=false

# CORS (adjust for your frontend domain in production)
SPEAKLY_CORS_ORIGINS=http://localhost:5173,https://speakly-frontend.fly.dev
