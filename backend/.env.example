# Speakly Backend Environment Configuration
# Copy this file to .env and fill in your values

# Application
SPEAKLY_ENVIRONMENT=prod
SPEAKLY_LOG_LEVEL=INFO

# Database (Railway will auto-provide DATABASE_URL)
DATABASE_URL=postgresql://user:password@host:port/database
# For local development:
# DATABASE_URL=sqlite:///./data/app.db

# Audio Storage
SPEAKLY_AUDIO_DIR=storage/audio

# Speech-to-Text Provider Configuration
# Options: auto (prefer Groq), groq (Whisper), elevenlabs (Scribe), mock (dev mode)
SPEAKLY_STT_PROVIDER=auto

# ElevenLabs STT Integration (premium, supports diarization)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_WEBHOOK_SECRET=your_webhook_secret_here
ELEVENLABS_WEBHOOK_ID=your_webhook_id_here
ELEVENLABS_DIARIZATION_ENABLED=true
ELEVENLABS_DIARIZATION_THRESHOLD=0.5

# Groq STT chunking configuration
GROQ_CHUNK_DURATION_SECONDS=600
GROQ_MIN_CHUNK_DURATION_SECONDS=60
GROQ_MAX_FILE_MB=24

# Note: GROQ_API_KEY (below) is used for both LLM and STT (Whisper)
# Groq STT: Free, fast, no diarization support

# LLM provider configuration (auto | groq | ollama | none)
SPEAKLY_LLM_PROVIDER=auto

# Groq LLM (for production - fast inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=deepseek-r1-distill-llama-70b

# Ollama LLM (for local development or separate GPU server)
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2:latest

# LLM Rate Limiting and Retry Configuration
# Max concurrent LLM sessions (prevents throttling during bulk uploads)
# Note: Each session makes 4 LLM calls (title, summary, todos, tags)
# So 2 concurrent sessions = up to 8 API calls in flight
SPEAKLY_LLM_MAX_CONCURRENT_REQUESTS=2
# Retry configuration for failed requests
SPEAKLY_LLM_RETRY_MAX_ATTEMPTS=5
SPEAKLY_LLM_RETRY_MIN_WAIT_SECONDS=2
SPEAKLY_LLM_RETRY_MAX_WAIT_SECONDS=60

# TickTick Integration (Optional)
TICKTICK_CLIENT_ID=your_ticktick_client_id
TICKTICK_CLIENT_SECRET=your_ticktick_client_secret
TICKTICK_REDIRECT_URI=https://your-domain.com/api/ticktick/callback

# Developer Mode (set to false for production)
SPEAKLY_DEVELOPER_MODE=false

# CORS (adjust for your frontend domain in production)
SPEAKLY_CORS_ORIGINS=http://localhost:5173,https://speakly-frontend.fly.dev,https://speakly-*.vercel.app

# Frontend URL (used for OAuth callbacks)
SPEAKLY_FRONTEND_URL=http://localhost:5173

# Journey report email (Brevo)
REPORT_EMAIL_ENABLED=false
REPORT_EMAIL_FROM_EMAIL=reports@example.com
REPORT_EMAIL_FROM_NAME="Speakly Journeys"
BREVO_API_KEY=your_brevo_api_key_here
