# Speakly consolidated environment configuration
# Copy this file to `.env` and fill in the values. Never commit your real `.env`.

# ----- Core app -----
SPEAKLY_ENVIRONMENT=dev
SPEAKLY_DATABASE_URL=sqlite:///./backend/app/data/app.db
SPEAKLY_AUDIO_DIR=backend/app/storage/audio
SPEAKLY_LOG_LEVEL=INFO
SPEAKLY_FRONTEND_URL=http://localhost:5173
SPEAKLY_CORS_ORIGINS=http://localhost:5173,https://speakly-frontend.fly.dev
SPEAKLY_DEVELOPER_MODE=false

# Usage limits / feature flags (optional)
SPEAKLY_MAX_TAGS_PER_SESSION=5
SPEAKLY_FREE_RECORDINGS_PER_MONTH=10
SPEAKLY_FREE_TASKS_PER_SESSION=3
SPEAKLY_FREE_TAGS_PER_SESSION=3
SPEAKLY_FEATURE_AUTO_TAGGING=true
SPEAKLY_FEATURE_CUSTOM_TAGS=true
SPEAKLY_FEATURE_ADVANCED_SEARCH=true
SPEAKLY_FEATURE_REPORT_GENERATION=false
SPEAKLY_FEATURE_COMMAND_PALETTE=true

# ----- Speech-to-Text Provider -----
# Choose provider: auto (prefer Groq), groq (Whisper), elevenlabs (Scribe), mock (dev)
SPEAKLY_STT_PROVIDER=auto

# ElevenLabs (Speech-to-Text) - Premium quality with diarization
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_WEBHOOK_SECRET=wsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_WEBHOOK_ID=
ELEVENLABS_DIARIZATION_ENABLED=true
ELEVENLABS_DIARIZATION_THRESHOLD=0.22

# Groq STT chunking configuration
GROQ_CHUNK_DURATION_SECONDS=600
GROQ_MIN_CHUNK_DURATION_SECONDS=60
GROQ_MAX_FILE_MB=24

# Note: Groq API key (below) is also used for STT via Whisper-large-v3
# Groq STT is free, fast, but doesn't support speaker diarization

# ----- LLM Provider (Groq or local Ollama) -----
# Pick provider via SPEAKLY_LLM_PROVIDER: auto|groq|ollama|none
SPEAKLY_LLM_PROVIDER=auto
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=
OLLAMA_MODEL_SUMMARY=llama3
OLLAMA_MODEL_TODO=llama3

# ----- Clerk (Auth) -----
# Backend: secret key validates JWTs; Frontend gets publishable key at build time
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Frontend build arg (set in CI/Deploy, not usually in .env):
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ----- TickTick (optional) -----
TICKTICK_ENABLED=false
TICKTICK_CLIENT_ID=
TICKTICK_CLIENT_SECRET=
TICKTICK_REDIRECT_URI=http://localhost:8000/api/ticktick/callback
TICKTICK_BASE_URL=https://api.ticktick.com/open/v1

# ----- PJ profile tagging (example metadata) -----
PJ_PROFILE_NAME=PJ
PJ_VOICE_TAGS=pj,patrick

# ----- Frontend (local dev) -----
# Only needed if running vite directly; in production passed via build args
VITE_API_BASE_URL=http://localhost:8000
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
