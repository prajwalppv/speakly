{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd backend && uv sync --frozen --no-dev",
    "nixpacksPlan": {
      "phases": {
        "setup": {
          "nixPkgs": ["python311", "postgresql", "uv", "ffmpeg"]
        }
      }
    }
  },
  "deploy": {
    "preDeployCommand": "cd backend && uv run alembic upgrade head",
    "startCommand": "cd backend && uv run uvicorn app.main:app --host 0.0.0.0 --port $PORT",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
